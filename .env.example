# ============ 必填：复制为 .env 后填入真实值 ============
# LLM（OpenAI 兼容协议，含 DeepSeek / 自建网关等）
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_BASE_URL=https://your-provider.com/v1
MODEL_NAME=your-model-name
# 网络搜索
TAVILY_API_KEY=tvly-xxxxxxxx

# ============ 可选：RAG / 检索（未设置时用 config.py 里的默认值）============
# 向量库后端：chroma（默认）/ opensearch
# RAG_STORE_BACKEND=chroma
# KB 召回条数（默认 5）
# RAG_TOP_K=5
# 相似度阈值，低于该分的结果被过滤（默认 0.6）
# RAG_MIN_SCORE=0.6
# 是否启用 rerank（默认 true）
# RAG_ENABLE_RERANK=true
# rerank 后保留条数（默认 5）
# RAG_RERANK_TOP_K=5
# hybrid 检索向量权重，仅 OpenSearch 后端生效（默认 0.5）
# RAG_HYBRID_ALPHA=0.5
# 切分参数
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_EMBED_BATCH_SIZE=32
# 文档目录 / Chroma 持久化目录（docker 部署时由 docker-compose 覆盖）
# DOCUMENTS_DIR=./data_layer/documents
# CHROMA_PERSIST_DIR=./local_chroma_db

# 本地 BGE 模型路径（缺省走 config.py 里的默认快照路径）
# BGE_MODEL_PATH=
# BGE_RERANK_MODEL_PATH=

# ============ 可选：OpenSearch 后端 ============
# OPENSEARCH_HOST=localhost
# OPENSEARCH_PORT=9200
# OPENSEARCH_INDEX=local_rag_docs
# EMBEDDING_DIM=768

# ============ 可选：工作流 ============
# 审核不通过最大回退次数（默认 3）
# MAX_REVISIONS=3
# MAX_SEARCH_RESULTS=5
# MAX_SEARCH_CONCURRENCY=5
# MAX_CITATIONS_PER_QUERY=5
# Writer 每次塞进 prompt 的引用/证据/结论上限
# WRITER_MAX_CITATIONS_IN_PROMPT=12
# WRITER_MAX_EVIDENCE_IN_PROMPT=8
# WRITER_MAX_FINDINGS_IN_PROMPT=8

# ============ 可选：服务 ============
# FastAPI CORS 允许的前端来源（逗号分隔）
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
